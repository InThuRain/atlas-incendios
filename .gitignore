__pycache__/
*.py[cod]
.venv/
build/national/

# Snapshots raw reproducibles: mantener locales; la publicación usa derivados web.
data/raw/gva/

# Snapshots recientes SIGIF/EFFIS y sus derivados. SIGIF no se redistribuye
# mientras sus condiciones de reutilizacion no esten aclaradas; todos se
# regeneran mediante el pipeline CV-2.2.
data/raw/recent/gva/
data/processed/recent/gva/

# Snapshot XML EGIF 1968-1992 y normalizados históricos reproducibles.
# Mantener locales hasta revisar el resultado de CV-3.2 y su publicación.
data/raw/egif/gva/
data/raw/egif/spain/
data/processed/egif/gva/
data/processed/egif/spain/
data/raw/esfire30/
data/processed/esfire30/

# Entrega directa CCINIF de la malla histórica EGIF. Licencia de
# redistribución pendiente; conservar originales y diagnósticos solo en local.
data/raw/ccinif/
data/derived/spain/es1_5/

# Fuentes territoriales nacionales de ES-2. Los libros INE y cartografías
# IGN/CNIG se descargan reproduciblemente; el snapshot canónico ligero y su
# manifiesto sí se versionan en data/territories y data/sources.
data/raw/territories/spain/
data/derived/spain/es2/
data/derived/spain/es3/
data/derived/spain/es4b2/
data/derived/spain/es4b3/
data/derived/spain/es4b4a/
# Muestras y serializaciones diagnósticas del diseño ES-4B5A. No son assets
# nacionales publicables ni sustituyen al futuro build web reanudable.
data/derived/spain/es4b5a/
# Capa BDLJE derivada para el prototipo territorial ES-4C2A. Se conserva
# local y se regenera desde el snapshot IGN/CNIG; no es un asset público.
data/derived/spain/es4c2a/
data/derived/spain/es4c2b/
# Shards municipales BDLJE locales de ES-4C2A3; los agregados de auditoría y
# el catálogo ligero versionable viven fuera de esta ruta.
data/derived/spain/es4c2a3/

# Dependencias JS locales del laboratorio nacional ES-3.
benchmarks/es3/node_modules/

# Checkpoints locales de ejecuciones reanudables de Codex. No contienen
# datasets ni son parte de un resultado publicable.
work/

# Salidas reproducibles con atributos y geometría ICV original.
data/processed/gva/*.jsonl
data/processed/gva/manifest.json
data/processed/gva/report.json
data/processed/gva/duplicate_geometry_report.json
data/processed/gva/duplicate_geometry_report.csv

# Derivados web y matrices de benchmark reproducibles. La matriz CV-1.4 contiene
# muchas variantes redundantes y no forma parte del subconjunto de producción.
data/derived/gva/web/
data/derived/gva/frontend/
data/derived/gva/publication/
data/derived/gva/data-ux-1/

# Benchmarks diagnósticos nacionales de ES-1; no son assets de producción.
data/derived/spain/es1/

# Subconjunto estático candidato para producción. Continúa ignorado hasta una
# acción explícita de publicación; se reconstruye con los scripts de build.
data/web/gva/
# Derivados nacionales experimentales y futuros builds EGIF: se generan de los
# snapshots locales y nunca deben entrar por accidente en Git.
data/web/spain/

# Artifact completo autocontenido de staging nacional ES-4D4A. Se construye
# localmente a partir de assets ya aprobados y nunca se versiona en Git.
build/national-pages-staging/
build/national-pages-staging-repro/
build/national-pages-staging-d4a1-original/
build/national-pages-staging-d4a1-repro/
build/national-pages-staging-d4a.tar.gz
build/national-pages-staging-d4a1.tar.gz

# Evaluación local acotada del mapa base Protomaps ES-4E3C2. El PMTiles,
# glyphs, capturas y artifacts proyectados son reproducibles pero demasiado
# grandes o dependientes de la máquina para entrar en Git.
build/es4e3c2-basemap/

# Artifact completo de producto E3D1 y su segunda construcción reproducible.
build/national-product-staging/
build/national-product-staging-repro/
build/national-product-frontend-check/
build/es4e3d1/

# Dependencias locales de los benchmarks JavaScript.
benchmarks/gva_web/node_modules/

# Resultados locales de Chromium para ES-4B5C. El harness y los escenarios sí
# se versionan; las mediciones dependen de máquina/navegador y se regeneran.
benchmarks/es4b5c/results.json

# Resultados locales del prototipo PMTiles nacional ES-4C. El prototipo y sus
# scripts se versionan; el PMTiles de ES-3 y las mediciones permanecen locales.
prototypes/es4c/smoke-results.json
prototypes/es4c/*-smoke-results.json
prototypes/es4c/c2a2-*.json
# Resultados locales de los smokes del índice municipal ESFire30; el harness y
# el informe reproducible se versionan, las medidas dependen del navegador.
prototypes/es4c/c2b3b1-*.json
# Smokes de consolidación ES-4C3A: dependen de máquina, viewport y caché local.
prototypes/es4c/c3a-*.json
prototypes/es4c/c3b-acceptance-results.json
# Reaceptación local ES-4C3C; contiene métricas dependientes de Chromium/caché.
prototypes/es4c/c3c-*.json
