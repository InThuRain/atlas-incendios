__pycache__/
*.py[cod]
.venv/

# Snapshots raw reproducibles: mantener locales; la publicación usa derivados web.
data/raw/gva/

# Snapshots recientes SIGIF/EFFIS y sus derivados. SIGIF no se redistribuye
# mientras sus condiciones de reutilizacion no esten aclaradas; todos se
# regeneran mediante el pipeline CV-2.2.
data/raw/recent/gva/
data/processed/recent/gva/

# Snapshot XML EGIF 1968-1992 y normalizados históricos reproducibles.
# Mantener locales hasta revisar el resultado de CV-3.2 y su publicación.
data/raw/egif/gva/
data/processed/egif/gva/

# Salidas reproducibles con atributos y geometría ICV original.
data/processed/gva/*.jsonl
data/processed/gva/manifest.json
data/processed/gva/report.json
data/processed/gva/duplicate_geometry_report.json
data/processed/gva/duplicate_geometry_report.csv

# Derivados web y matrices de benchmark reproducibles. La matriz CV-1.4 contiene
# muchas variantes redundantes y no forma parte del subconjunto de producción.
data/derived/gva/web/
data/derived/gva/frontend/

# Subconjunto estático candidato para producción. Continúa ignorado hasta una
# acción explícita de publicación; se reconstruye con los scripts de build.
data/web/gva/

# Dependencias locales de los benchmarks JavaScript.
benchmarks/gva_web/node_modules/
