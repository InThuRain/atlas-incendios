{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-incendios.example/schemas/national/v1/atlas-contracts.schema.json",
  "title": "Atlas national canonical contracts v1",
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "provenance": {
      "type": "object",
      "required": ["source_id", "source_record_id", "retrieved_at", "transformations"],
      "properties": {
        "source_id": {"$ref": "#/$defs/identifier"},
        "source_record_id": {"type": ["string", "null"]},
        "source_url": {"type": ["string", "null"], "format": "uri"},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "snapshot_id": {"type": ["string", "null"]},
        "transformations": {"type": "array", "items": {"type": "string"}},
        "checksums": {"type": "object", "additionalProperties": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "temporalValidity": {
      "type": "object",
      "required": ["start", "end", "coverage_status", "completeness_status"],
      "properties": {
        "start": {"type": ["string", "null"]},
        "end": {"type": ["string", "null"]},
        "coverage_status": {
          "enum": ["selective", "transitional", "systematic", "partial", "complete", "unknown"]
        },
        "completeness_status": {
          "enum": ["final", "provisional", "incomplete", "unknown"]
        }
      },
      "additionalProperties": false
    },
    "sourceRecord": {
      "type": "object",
      "required": ["record_id", "source_id", "entity_type", "temporal_validity", "geometry_ids", "spatial_reference_id", "provenance"],
      "properties": {
        "record_id": {"$ref": "#/$defs/identifier"},
        "source_record_id": {"type": ["string", "null"]},
        "legacy_ids": {"type": "array", "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true},
        "source_id": {"$ref": "#/$defs/identifier"},
        "entity_type": {
          "enum": ["administrative_record", "remote_sensing_observation", "official_fire_record", "provisional_administrative_record"]
        },
        "episode_id": {"type": ["string", "null"]},
        "episode_identity_status": {"enum": ["confirmed", "candidate", "unresolved", "not_applicable"]},
        "temporal_validity": {"$ref": "#/$defs/temporalValidity"},
        "declared_territory_ids": {"type": "array", "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true},
        "geometry_ids": {"type": "array", "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true},
        "geometry_id": {"type": ["string", "null"], "description": "Optional legacy singular pointer; geometry_ids is canonical."},
        "spatial_reference_id": {"type": ["string", "null"]},
        "provenance": {"$ref": "#/$defs/provenance"}
      },
      "additionalProperties": true
    },
    "fireGeometry": {
      "type": "object",
      "required": ["geometry_id", "source_id", "geometry_semantics", "quality", "geometry", "territory_relation_ids", "provenance"],
      "properties": {
        "geometry_id": {"$ref": "#/$defs/identifier"},
        "legacy_ids": {"type": "array", "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true},
        "source_id": {"$ref": "#/$defs/identifier"},
        "source_record_ids": {"type": "array", "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true},
        "geometry_semantics": {
          "enum": [
            "official_fire_perimeter",
            "documented_remote_sensing_perimeter",
            "provisional_remote_sensing_perimeter",
            "administrative_point",
            "documented_cartographic_reconstruction"
          ]
        },
        "quality": {"enum": ["A_official", "B_documented", "B_provisional", "C_reconstruction", "unassigned"]},
        "geometry": {"type": ["object", "null"]},
        "territory_relation_ids": {"type": "array", "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true},
        "provenance": {"$ref": "#/$defs/provenance"}
      },
      "additionalProperties": true
    },
    "historicalSpatialReference": {
      "type": "object",
      "required": ["spatial_reference_id", "source_id", "spatial_semantics", "interpretation_status", "geometry_parts", "provenance"],
      "properties": {
        "spatial_reference_id": {"$ref": "#/$defs/identifier"},
        "source_id": {"$ref": "#/$defs/identifier"},
        "spatial_semantics": {"const": "historical_location_reference"},
        "reference_system": {"type": ["string", "null"]},
        "sheet_id": {"type": ["string", "null"]},
        "grid_id": {"type": ["string", "null"]},
        "nominal_resolution_m": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "interpretation_status": {"enum": ["confirmed", "ambiguous", "unusable", "no_reference"]},
        "geometry_parts": {"type": "array", "items": {"type": "object"}},
        "geometry_status": {"const": "not_fire_geometry"},
        "provenance": {"$ref": "#/$defs/provenance"}
      },
      "additionalProperties": true
    },
    "territory": {
      "type": "object",
      "required": ["territory_id", "territory_type", "official_code", "official_name", "parent_id", "valid_from", "valid_to", "aliases", "predecessor_ids", "successor_ids", "provenance"],
      "properties": {
        "territory_id": {"$ref": "#/$defs/identifier"},
        "territory_type": {"enum": ["country", "autonomous_community", "autonomous_city", "province", "municipality"]},
        "official_code": {"type": "string"},
        "official_name": {"type": "string", "minLength": 1},
        "parent_id": {"type": ["string", "null"]},
        "province_equivalent_code": {"type": ["string", "null"], "pattern": "^[0-9]{2}$"},
        "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "valid_from": {"type": ["string", "null"], "format": "date"},
        "valid_to": {"type": ["string", "null"], "format": "date"},
        "predecessor_ids": {"type": "array", "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true},
        "successor_ids": {"type": "array", "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true},
        "provenance": {"$ref": "#/$defs/provenance"}
      },
      "additionalProperties": true
    },
    "territoryRelation": {
      "type": "object",
      "required": ["territory_relation_id", "subject_id", "territory_id", "relation_type", "mapping_status", "qa_status", "provenance"],
      "properties": {
        "territory_relation_id": {"$ref": "#/$defs/identifier"},
        "subject_id": {"$ref": "#/$defs/identifier"},
        "territory_id": {"$ref": "#/$defs/identifier"},
        "relation_type": {"enum": ["source_declared", "spatial_intersection", "canonical_mapping", "historical_mapping"]},
        "mapping_status": {"enum": ["confirmed", "candidate", "unresolved", "not_applicable"]},
        "qa_status": {
          "enum": ["match", "province_match", "province_mismatch", "autonomous_community_match", "autonomous_community_mismatch", "municipality_match", "municipality_mismatch", "not_checkable"]
        },
        "provenance": {"$ref": "#/$defs/provenance"}
      },
      "additionalProperties": true
    },
    "candidateLink": {
      "type": "object",
      "required": ["candidate_link_id", "subject_id", "object_id", "link_type", "status", "evidence", "provenance"],
      "properties": {
        "candidate_link_id": {"$ref": "#/$defs/identifier"},
        "subject_id": {"$ref": "#/$defs/identifier"},
        "object_id": {"$ref": "#/$defs/identifier"},
        "link_type": {"enum": ["same_episode_candidate", "record_geometry_candidate", "supersedes_candidate"]},
        "status": {"enum": ["candidate", "reviewed_rejected", "confirmed"]},
        "score": {"type": ["number", "null"]},
        "evidence": {"type": "array", "items": {"type": "object"}},
        "provenance": {"$ref": "#/$defs/provenance"}
      },
      "additionalProperties": true
    },
    "causeMapping": {
      "type": "object",
      "required": ["source_id", "source_value", "canonical_code", "mapping_status", "display_label", "provenance"],
      "properties": {
        "source_id": {"$ref": "#/$defs/identifier"},
        "source_value": {},
        "canonical_code": {"type": ["string", "null"]},
        "mapping_status": {"enum": ["documented", "candidate", "unmapped"]},
        "display_label": {"type": ["string", "null"]},
        "provenance": {"$ref": "#/$defs/provenance"}
      },
      "additionalProperties": true
    }
  }
}
